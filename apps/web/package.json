{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm with-env next build",
    "postbuild": "next-sitemap",
    "sitemap": "next-sitemap",
    "validate:domain": "node ./scripts/validate-custom-domain.mjs",
    "deploy": "pnpm validate:domain && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "pnpm with-env wrangler types --env-interface CloudflareEnv --include-runtime false ./types/cloudflare-env.d.ts",
    "clean": "git clean -xdf .cache .turbo dist .next .open-next .wrangler",
    "clean:all": "pnpm clean && git clean -xdf node_modules",
    "dev": "next dev",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "start": "pnpm with-env next start",
    "typecheck": "tsc --noEmit",
    "with-env": "node ./run-with-root-env.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@internal/configs": "workspace:*",
    "@internal/styles": "workspace:*",
    "@internal/ui": "workspace:*",
    "@internal/utils": "workspace:*",
    "@opennextjs/cloudflare": "catalog:next",
    "next": "catalog:next",
    "next-themes": "catalog:next",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "zod": "catalog:validation"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:cloudflare",
    "@internal/eslint-config": "workspace:*",
    "@internal/prettier-config": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@pixpilot/env": "catalog:pixpilot",
    "@pixpilot/nextjs-env": "catalog:pixpilot",
    "@pixpilot/nextjs-test-utils": "catalog:pixpilot",
    "@tailwindcss/postcss": "catalog:styling",
    "@types/node": "catalog:tooling",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "autoprefixer": "catalog:styling",
    "jiti": "catalog:tooling",
    "next-sitemap": "catalog:next",
    "prettier": "catalog:tooling",
    "tailwindcss": "catalog:styling",
    "typescript": "catalog:tooling",
    "wrangler": "catalog:cloudflare"
  }
}
