{
  "name": "nextjs-cloudflare-monorepo-template",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "description": "A production-ready Next.js 16 monorepo template with Cloudflare Workers deployment, TypeScript, Tailwind CSS, and Turborepo for fast development and edge deployment.",
  "keywords": [
    "nextjs",
    "cloudflare",
    "workers",
    "monorepo",
    "typescript",
    "tailwindcss",
    "turborepo",
    "template",
    "edge",
    "serverless"
  ],
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=9.6.0"
  },
  "scripts": {
    "setup": "npx @pixpilot/scaffoldfy --config ./setup/scaffoldfy.json",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "build": "turbo run build",
    "tsc:watch": "pnpm exec tsc --noEmit --watch --project tsconfig.watch.json",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "pnpm format --write",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache && pnpm lint:root",
    "lint:fix": "pnpm lint --fix && pnpm lint:root:fix",
    "lint:root": "eslint scripts .github *.config.{js,cjs,mjs,ts} *.json README.md --cache --cache-location .cache/.eslintcache",
    "lint:root:fix": "pnpm lint:root --fix",
    "lint:ws": "pnpm dlx sherif@latest",
    "fix:all": "pnpm format:fix && pnpm lint:fix",
    "postinstall": "pnpm lint:ws && node setup/guard.mjs warn",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --config tooling/vitest/index.js",
    "prepare": "husky",
    "clean:workspaces": "turbo run clean:all && git clean -xdf .cache .turbo",
    "clean:workspaces:install": "pnpm clean:workspaces && pnpm install",
    "deps:update": "npx taze -r -w && pnpm install",
    "deps:update:major": "npx taze major -r -w && pnpm install",
    "gen:package": "npx @pixpilot/scaffoldfy --config ./generators/package/scaffoldfy.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:cloudflare",
    "@commitlint/cli": "catalog:tooling",
    "@commitlint/config-conventional": "catalog:tooling",
    "@internal/prettier-config": "workspace:*",
    "@turbo/gen": "catalog:tooling",
    "@vitest/coverage-v8": "catalog:testing",
    "@vitest/ui": "catalog:testing",
    "husky": "catalog:tooling",
    "lint-staged": "catalog:tooling",
    "prettier": "catalog:tooling",
    "tsx": "catalog:tooling",
    "turbo": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vitest": "catalog:testing"
  },
  "prettier": "@internal/prettier-config"
}
